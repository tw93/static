name: Flower Simple Proxy
desc: Manual proxy selection for Flower. Proxy and AI Proxy each pick Hong Kong, United States, or DIRECT; HK and US sub-groups list individual nodes.
category: Proxy

profile:
  store-selected: true

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localdomain"
    - "*.home.arpa"
    - "+.cn"
    - "+.baidu.com"
    - "+.taobao.com"
    - "+.tmall.com"
    - "+.alipay.com"
    - "+.aliyun.com"
    - "+.alibaba.com"
    - "+.dingtalk.com"
    - "+.qq.com"
    - "+.wechat.com"
    - "+.weixin.qq.com"
    - "+.icloud.com"
    - "+.apple.com"
    - "+.push.apple.com"
    - "+.xiaomi.com"
    - "+.mi.com"
    - "+.bilibili.com"
    - "+.163.com"
    - "+.126.com"
    - "+.netease.com"
    - "+.jd.com"
    - "+.jdcloud.com"
    - "+.360buyimg.com"
    - "+.weibo.com"
    - "+.xiaohongshu.com"
    - "+.xhscdn.com"
    - "+.douyin.com"
    - "+.douyinpic.com"
    - "+.bytedance.com"
    - "+.toutiao.com"
    - "+.snssdk.com"
    - "+.meituan.com"
    - "+.meituan.net"
    - "+.dianping.com"
    - "+.kuaishou.com"
    - "+.gifshow.com"
    - "+.pinduoduo.com"
    - "+.yangkeduo.com"
    - "+.zhihu.com"
    - "+.zhimg.com"
    - "time.*.com"
    - "ntp.*.com"
    - "stun.*.*"
    - "stun.*.*.*"
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4

proxy-groups: #!replace
  - name: Proxy
    type: select
    proxies:
      - HK
      - US
      - DIRECT

  - name: AI Proxy
    type: select
    proxies:
      - US
      - HK
      - DIRECT

  - name: HK
    type: select
    proxies:
      - 🇭🇰 香港高级 IEPL 专线 2
      - 🇭🇰 香港标准 IEPL 专线 5
      - 🇭🇰 香港高级 IEPL 专线 1
      - 🇭🇰 香港标准 IEPL 专线 2
      - 🇭🇰 香港标准 IEPL 专线 1
      - 🇭🇰 香港标准 IEPL 专线 6
      - 🇭🇰 香港标准 IEPL 专线 4
      - 🇭🇰 香港标准 IEPL 专线 7
      - 🇭🇰 香港实验性 IEPL 专线 1
      - 🇭🇰 香港标准 IEPL 专线 3
      - 🇭🇰 香港高级 IEPL 专线 3
      - 🇭🇰 香港标准 IEPL 专线 8

  - name: US
    type: select
    proxies:
      - 🇺🇸 美国标准 IEPL 专线 8
      - 🇺🇸 美国标准 IEPL 专线 4
      - 🇺🇸 美国标准 IEPL 专线 7
      - 🇺🇸 美国标准 IEPL 专线 5
      - 🇺🇸 美国标准 IEPL 专线 3
      - 🇺🇸 美国标准 IEPL 专线 2
      - 🇺🇸 美国高级 IEPL 专线 3
      - 🇺🇸 美国标准 IEPL 专线 1
      - 🇺🇸 美国高级 IEPL 专线 1
      - 🇺🇸 美国高级 IEPL 专线 2
      - 🇺🇸 美国标准 IEPL 专线 6
      - 🇺🇸 美国实验性 IEPL 专线 1

rules: #!replace
  # === Direct ===
  - DOMAIN-SUFFIX,qoder.sh,DIRECT

  # === OpenAI / ChatGPT / Codex ===
  - DOMAIN-SUFFIX,openai.com,AI Proxy
  - DOMAIN-SUFFIX,chatgpt.com,AI Proxy
  - DOMAIN-SUFFIX,oaistatic.com,AI Proxy
  - DOMAIN-SUFFIX,oaiusercontent.com,AI Proxy
  - DOMAIN-SUFFIX,openai-cdn.com,AI Proxy
  - DOMAIN-SUFFIX,openaiapi-site.azureedge.net,AI Proxy
  - DOMAIN-SUFFIX,openaicom.imgix.net,AI Proxy
  - DOMAIN,openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net,AI Proxy
  - DOMAIN,production-openaicom-storage.azureedge.net,AI Proxy
  - DOMAIN-SUFFIX,livekit.cloud,AI Proxy

  # === Claude / Anthropic ===
  - DOMAIN-SUFFIX,anthropic.com,AI Proxy
  - DOMAIN-SUFFIX,claude.ai,AI Proxy
  - DOMAIN-SUFFIX,claude.com,AI Proxy
  - DOMAIN-SUFFIX,claudeusercontent.com,AI Proxy
  - DOMAIN-SUFFIX,ant.dev,AI Proxy
  - DOMAIN-SUFFIX,claudeaistatus.com,AI Proxy

  # === Gemini / Google AI ===
  # Region-locked services stay on AI Proxy; the Proxy group may point at
  # Hong Kong where Gemini is blocked.
  - DOMAIN,accounts.google.com,AI Proxy
  - DOMAIN-SUFFIX,deepmind.com,AI Proxy
  - DOMAIN-SUFFIX,generativeai.google,AI Proxy
  - DOMAIN,gemini.google.com,AI Proxy
  - DOMAIN,bard.google.com,AI Proxy
  - DOMAIN,aistudio.google.com,AI Proxy
  - DOMAIN,makersuite.google.com,AI Proxy
  - DOMAIN,generativelanguage.googleapis.com,AI Proxy
  - DOMAIN,ai.google.dev,AI Proxy
  - DOMAIN,notebooklm.google.com,AI Proxy
  - DOMAIN-SUFFIX,google-gemini.dev,AI Proxy

  # === Google APIs (non-Gemini) ===
  # generativelanguage.googleapis.com above must stay before this suffix rule.
  - DOMAIN-SUFFIX,googleapis.com,Proxy
  - DOMAIN-SUFFIX,tensorflow.org,Proxy

  # === xAI / Groq ===
  - DOMAIN-SUFFIX,x.ai,AI Proxy
  - DOMAIN-SUFFIX,grok.com,AI Proxy
  - DOMAIN,api.x.ai,AI Proxy
  - DOMAIN-SUFFIX,groq.com,AI Proxy

  # === Coding agents and tools ===
  # No US requirement; keep them off the AI line so git and tooling traffic
  # does not compete with Claude/OpenAI streaming.
  - DOMAIN-SUFFIX,cursor.sh,Proxy
  - DOMAIN-SUFFIX,cursor.com,Proxy
  - DOMAIN-SUFFIX,cursorapi.com,Proxy
  - DOMAIN-SUFFIX,cursor-cdn.com,Proxy
  - DOMAIN-SUFFIX,github.com,Proxy
  - DOMAIN-SUFFIX,githubusercontent.com,Proxy
  - DOMAIN-SUFFIX,githubcopilot.com,Proxy
  - DOMAIN-SUFFIX,copilot.github.com,Proxy

  # === Other AI services ===
  - DOMAIN-SUFFIX,cohere.com,Proxy
  - DOMAIN-SUFFIX,mistral.ai,Proxy
  - DOMAIN-SUFFIX,together.ai,Proxy
  - DOMAIN-SUFFIX,replicate.com,Proxy
  - DOMAIN-SUFFIX,huggingface.co,Proxy
  - DOMAIN-SUFFIX,perplexity.ai,Proxy
  - DOMAIN-SUFFIX,pplx.ai,Proxy
  - DOMAIN-SUFFIX,openrouter.ai,Proxy
  - DOMAIN-SUFFIX,windsurf.com,Proxy
  - DOMAIN-SUFFIX,codeium.com,Proxy
  - DOMAIN-SUFFIX,v0.dev,Proxy
  - DOMAIN-SUFFIX,bolt.new,Proxy
  - DOMAIN-SUFFIX,midjourney.com,Proxy
  - DOMAIN-SUFFIX,workers.dev,Proxy

  # === AI session / risk-control (must share exit with claude.ai) ===
  - DOMAIN,challenges.cloudflare.com,AI Proxy
  - DOMAIN-SUFFIX,workos.com,AI Proxy
  - DOMAIN-SUFFIX,stripe.com,AI Proxy

  # === AI dependencies (telemetry and widgets, exit does not matter) ===
  - DOMAIN-SUFFIX,segment.io,Proxy
  - DOMAIN-SUFFIX,intercom.io,Proxy
  - DOMAIN-SUFFIX,intercomcdn.com,Proxy
  - DOMAIN-SUFFIX,sentry.io,Proxy
  - DOMAIN-SUFFIX,algolia.net,Proxy
  - DOMAIN-SUFFIX,statsig.com,Proxy
  - DOMAIN-SUFFIX,launchdarkly.com,Proxy
  - DOMAIN-SUFFIX,honeycomb.io,Proxy
  - DOMAIN-SUFFIX,datadoghq.com,Proxy

  # === Domestic consumer direct ===
  - DOMAIN-SUFFIX,alipay.com,DIRECT
  - DOMAIN-SUFFIX,taobao.com,DIRECT
  - DOMAIN-SUFFIX,aliyun.com,DIRECT
  - DOMAIN-SUFFIX,aliyuncs.com,DIRECT
  - DOMAIN-SUFFIX,fliggy.com,DIRECT
  - DOMAIN-SUFFIX,yuque.com,DIRECT
  - DOMAIN-SUFFIX,dingtalk.com,DIRECT
  - DOMAIN-SUFFIX,dingtalkapps.com,DIRECT
  - DOMAIN-SUFFIX,dingtalk.net,DIRECT
  - DOMAIN-SUFFIX,alicdn.com,DIRECT
  - DOMAIN-SUFFIX,aliimg.com,DIRECT
  - DOMAIN-SUFFIX,sspai.com,DIRECT

  # === Private ranges ===
  - GEOIP,private,DIRECT,no-resolve

  # === Force Hong Kong ===
  - DOMAIN-SUFFIX,apple-relay.akamaized.net,HK
  - DOMAIN-SUFFIX,apple-relay.apple.com,HK
  - DOMAIN-SUFFIX,apple-relay.cloudflare.com,HK
  - DOMAIN-SUFFIX,apple-relay.fastly-edge.com,HK
  - DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,HK
  - DOMAIN-SUFFIX,push.apple.com,HK
  - DOMAIN-SUFFIX,api.push.apple.com,HK
  - DOMAIN-SUFFIX,courier.push.apple.com,HK
  - DOMAIN-SUFFIX,wx.qq.com,HK
  - DOMAIN-SUFFIX,v2ex.com,HK

  # === WeChat / Tencent direct ===
  - DOMAIN-SUFFIX,wechat.com,DIRECT
  - DOMAIN-SUFFIX,wechatlegal.net,DIRECT
  - DOMAIN-SUFFIX,wechatos.net,DIRECT
  - DOMAIN-SUFFIX,wechatpay.com,DIRECT
  - DOMAIN-SUFFIX,weixin.com,DIRECT
  - DOMAIN-SUFFIX,weixinbridge.com,DIRECT
  - DOMAIN-SUFFIX,weixinsxy.com,DIRECT
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,wxs.qq.com,DIRECT
  - DOMAIN-SUFFIX,servicewechat.com,DIRECT
  - DOMAIN-SUFFIX,tenpay.com,DIRECT
  - DOMAIN-SUFFIX,qpic.cn,DIRECT
  - DOMAIN-SUFFIX,qlogo.cn,DIRECT
  - DOMAIN-SUFFIX,gtimg.com,DIRECT
  - DOMAIN-SUFFIX,tc.qq.com,DIRECT

  # === Apple / iCloud direct (apple-relay & push forced to HK above) ===
  - DOMAIN-SUFFIX,apple.com,DIRECT
  - DOMAIN-SUFFIX,apple.com.cn,DIRECT
  - DOMAIN-SUFFIX,apple-dns.net,DIRECT
  - DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT
  - DOMAIN-SUFFIX,apple-mapkit.com,DIRECT
  - DOMAIN-SUFFIX,apple.news,DIRECT
  - DOMAIN-SUFFIX,cdn-apple.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com.cn,DIRECT
  - DOMAIN-SUFFIX,icloud-content.com,DIRECT
  - DOMAIN-SUFFIX,itunes.com,DIRECT
  - DOMAIN-SUFFIX,itunes.apple.com,DIRECT
  - DOMAIN-SUFFIX,music.apple.com,DIRECT
  - DOMAIN-SUFFIX,mzstatic.com,DIRECT
  - DOMAIN-SUFFIX,aaplimg.com,DIRECT
  - DOMAIN-SUFFIX,me.com,DIRECT
  - DOMAIN-SUFFIX,appsto.re,DIRECT

  # === Domestic fallback ===
  - DOMAIN-SUFFIX,cn,DIRECT
  - GEOIP,CN,DIRECT

  # === Default ===
  - MATCH,Proxy
