name: Nexitally Stash Override
desc: Manual proxy selection. Proxies group lists Hong Kong, Japan, Singapore nodes in measured-latency order; AI group lists United States Seattle nodes. Splits AI services to the AI group and keeps domestic traffic direct.
category: Proxy

profile:
  store-selected: true

dns: #!replace
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localdomain"
    - "*.home.arpa"
    - "+.cn"
    - "+.baidu.com"
    - "+.taobao.com"
    - "+.tmall.com"
    - "+.alipay.com"
    - "+.aliyun.com"
    - "+.alibaba.com"
    - "+.qq.com"
    - "+.wechat.com"
    - "+.weixin.qq.com"
    - "+.icloud.com"
    - "+.icloud-content.com"
    - "+.apple-cloudkit.com"
    - "+.apple.com"
    - "+.push.apple.com"
    - "+.apple-dns.net"
    - "+.cdn-apple.com"
    - "+.mzstatic.com"
    - "+.xiaomi.com"
    - "+.mi.com"
    - "+.bilibili.com"
    - "+.163.com"
    - "+.126.com"
    - "+.netease.com"
    - "+.jd.com"
    - "+.jdcloud.com"
    - "+.360buyimg.com"
    - "+.weibo.com"
    - "+.xiaohongshu.com"
    - "+.xhscdn.com"
    - "+.douyin.com"
    - "+.douyinpic.com"
    - "+.bytedance.com"
    - "+.toutiao.com"
    - "+.snssdk.com"
    - "+.meituan.com"
    - "+.meituan.net"
    - "+.dianping.com"
    - "+.kuaishou.com"
    - "+.gifshow.com"
    - "+.pinduoduo.com"
    - "+.yangkeduo.com"
    - "+.zhihu.com"
    - "+.zhimg.com"
    - "time.*.com"
    - "ntp.*.com"
    - "stun.*.*"
    - "stun.*.*.*"
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver-policy:
    "+.reddit.com": [https://1.1.1.1/dns-query, https://8.8.8.8/dns-query]
    "+.redd.it": [https://1.1.1.1/dns-query, https://8.8.8.8/dns-query]
    "+.redditmedia.com": [https://1.1.1.1/dns-query, https://8.8.8.8/dns-query]
    "+.redditstatic.com": [https://1.1.1.1/dns-query, https://8.8.8.8/dns-query]
  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4

proxy-groups: #!replace
  - name: Proxies
    type: select
    proxies:
      - 🇭🇰 Hong Kong 19
      - 🇭🇰 Hong Kong 16
      - 🇭🇰 Hong Kong 01
      - 🇭🇰 Hong Kong 07
      - 🇭🇰 Hong Kong 12
      - 🇭🇰 Hong Kong 23
      - 🇭🇰 Hong Kong 15
      - 🇭🇰 Hong Kong 13
      - 🇭🇰 Hong Kong 17
      - 🇭🇰 Hong Kong 11
      - 🇭🇰 Hong Kong 18
      - 🇭🇰 Hong Kong 08
      - 🇭🇰 Hong Kong 14
      - 🇭🇰 Hong Kong 04
      - 🇭🇰 Hong Kong 06
      - 🇭🇰 Hong Kong 02
      - 🇭🇰 Hong Kong 03
      - 🇭🇰 Hong Kong 10
      - 🇭🇰 Hong Kong 09
      - 🇭🇰 Hong Kong 05
      - 🇯🇵 Japan 13
      - 🇯🇵 Japan 27
      - 🇯🇵 Japan 16
      - 🇯🇵 Japan 14
      - 🇯🇵 Japan 24
      - 🇯🇵 Japan 18
      - 🇯🇵 Japan 25
      - 🇯🇵 Japan 21
      - 🇯🇵 Japan 17
      - 🇯🇵 Japan 19
      - 🇯🇵 Japan 20
      - 🇯🇵 Japan 07
      - 🇯🇵 Japan 12
      - 🇯🇵 Japan 11
      - 🇯🇵 Japan 10
      - 🇯🇵 Japan 04
      - 🇯🇵 Japan 08
      - 🇯🇵 Japan 03
      - 🇯🇵 Japan 05
      - 🇯🇵 Japan 15
      - 🇯🇵 Japan 02
      - 🇯🇵 Japan 06
      - 🇯🇵 Japan 09
      - 🇯🇵 Japan 01
      - 🇯🇵 Japan 26
      - 🇸🇬 Singapore 07
      - 🇸🇬 Singapore 03
      - 🇸🇬 Singapore 12
      - 🇸🇬 Singapore 06
      - 🇸🇬 Singapore 04
      - 🇸🇬 Singapore 02
      - 🇸🇬 Singapore 05
      - 🇸🇬 Singapore 01
      - 🇸🇬 Singapore 08
      - 🇸🇬 Singapore 10
      - 🇸🇬 Singapore 09

  - name: AI
    type: select
    proxies:
      - "🇺🇸 USA Seattle 07 [DIP USA-Seattle]"
      - 🇺🇸 USA Seattle 03
      - 🇺🇸 USA Seattle 06
      - 🇺🇸 USA Seattle 02
      - 🇺🇸 USA Seattle 01
      - 🇺🇸 USA Seattle 04
      - 🇺🇸 USA Seattle 05
      - 🇺🇸 USA Seattle 08
      - 🇺🇸 USA Seattle 09

  - name: Final
    type: select
    proxies:
      - Proxies
      - DIRECT

rules: #!replace
  # === Direct ===
  - DOMAIN-SUFFIX,qoder.sh,DIRECT
  # Apple code-signing RFC3161 timestamp server: must bypass the proxy or
  # `codesign --timestamp` fails with "The timestamp service is not available"
  # during release DMG signing (TUN/fake-ip captures it otherwise).
  - DOMAIN,timestamp.apple.com,DIRECT

  # === Reddit ===
  - DOMAIN-SUFFIX,reddit.com,AI
  - DOMAIN-SUFFIX,redd.it,AI
  - DOMAIN-SUFFIX,redditmedia.com,AI
  - DOMAIN-SUFFIX,redditstatic.com,AI

  # === OpenAI / ChatGPT / Codex ===
  - DOMAIN-SUFFIX,openai.com,AI
  - DOMAIN-SUFFIX,chatgpt.com,AI
  - DOMAIN-SUFFIX,oaistatic.com,AI
  - DOMAIN-SUFFIX,oaiusercontent.com,AI
  - DOMAIN-SUFFIX,openai-cdn.com,AI
  - DOMAIN-SUFFIX,openaiapi-site.azureedge.net,AI
  - DOMAIN-SUFFIX,openaicom.imgix.net,AI
  - DOMAIN,openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net,AI
  - DOMAIN,production-openaicom-storage.azureedge.net,AI
  - DOMAIN-SUFFIX,livekit.cloud,AI

  # === Claude / Anthropic ===
  - DOMAIN-SUFFIX,anthropic.com,AI
  - DOMAIN-SUFFIX,claude.ai,AI
  - DOMAIN-SUFFIX,claude.com,AI
  - DOMAIN-SUFFIX,claudeusercontent.com,AI
  - DOMAIN-SUFFIX,ant.dev,AI
  - DOMAIN-SUFFIX,claudeaistatus.com,AI

  # === Gemini / Google AI ===
  # Region-locked services stay on the AI group even though the DIP node is
  # slower; the Proxies group may point at Hong Kong where Gemini is blocked.
  - DOMAIN,accounts.google.com,AI
  - DOMAIN-SUFFIX,deepmind.com,AI
  - DOMAIN-SUFFIX,generativeai.google,AI
  - DOMAIN,gemini.google.com,AI
  - DOMAIN,bard.google.com,AI
  - DOMAIN,aistudio.google.com,AI
  - DOMAIN,makersuite.google.com,AI
  - DOMAIN,generativelanguage.googleapis.com,AI
  - DOMAIN,ai.google.dev,AI
  - DOMAIN,notebooklm.google.com,AI
  - DOMAIN-SUFFIX,google-gemini.dev,AI

  # === Google APIs (non-Gemini) ===
  # generativelanguage.googleapis.com above must stay before this suffix rule.
  - DOMAIN-SUFFIX,googleapis.com,Proxies
  - DOMAIN-SUFFIX,tensorflow.org,Proxies

  # === xAI / Groq ===
  - DOMAIN-SUFFIX,x.ai,AI
  - DOMAIN-SUFFIX,grok.com,AI
  - DOMAIN,api.x.ai,AI
  - DOMAIN-SUFFIX,groq.com,AI

  # === Cursor ===
  # Cursor model traffic shares the US exit with the other AI services.
  - DOMAIN-SUFFIX,cursor.sh,AI
  - DOMAIN-SUFFIX,cursor.com,AI
  - DOMAIN-SUFFIX,cursorapi.com,AI
  - DOMAIN-SUFFIX,cursor-cdn.com,AI

  # === Coding agents and tools ===
  # No US requirement; keep them off the slow DIP node so git and tooling
  # traffic does not compete with Claude/OpenAI streaming.
  - DOMAIN-SUFFIX,github.com,Proxies
  - DOMAIN-SUFFIX,githubusercontent.com,Proxies
  - DOMAIN-SUFFIX,githubcopilot.com,Proxies
  - DOMAIN-SUFFIX,copilot.github.com,Proxies

  # === Other AI services ===
  - DOMAIN-SUFFIX,cohere.com,Proxies
  - DOMAIN-SUFFIX,mistral.ai,Proxies
  - DOMAIN-SUFFIX,together.ai,Proxies
  - DOMAIN-SUFFIX,replicate.com,Proxies
  - DOMAIN-SUFFIX,huggingface.co,Proxies
  - DOMAIN-SUFFIX,perplexity.ai,Proxies
  - DOMAIN-SUFFIX,pplx.ai,Proxies
  - DOMAIN-SUFFIX,openrouter.ai,Proxies
  - DOMAIN-SUFFIX,windsurf.com,Proxies
  - DOMAIN-SUFFIX,codeium.com,Proxies
  - DOMAIN-SUFFIX,v0.dev,Proxies
  - DOMAIN-SUFFIX,bolt.new,Proxies
  - DOMAIN-SUFFIX,midjourney.com,Proxies
  - DOMAIN-SUFFIX,workers.dev,Proxies

  # === AI session / risk-control (must share exit with claude.ai) ===
  - DOMAIN,challenges.cloudflare.com,AI
  - DOMAIN-SUFFIX,workos.com,AI
  - DOMAIN-SUFFIX,stripe.com,AI

  # === AI dependencies (telemetry and widgets, exit does not matter) ===
  - DOMAIN-SUFFIX,segment.io,Proxies
  - DOMAIN-SUFFIX,intercom.io,Proxies
  - DOMAIN-SUFFIX,intercomcdn.com,Proxies
  - DOMAIN-SUFFIX,sentry.io,Proxies
  - DOMAIN-SUFFIX,algolia.net,Proxies
  - DOMAIN-SUFFIX,statsig.com,Proxies
  - DOMAIN-SUFFIX,launchdarkly.com,Proxies
  - DOMAIN-SUFFIX,honeycomb.io,Proxies
  - DOMAIN-SUFFIX,datadoghq.com,Proxies

  # === Domestic consumer direct ===
  - DOMAIN-SUFFIX,alipay.com,DIRECT
  - DOMAIN-SUFFIX,taobao.com,DIRECT
  - DOMAIN-SUFFIX,aliyun.com,DIRECT
  - DOMAIN-SUFFIX,aliyuncs.com,DIRECT
  - DOMAIN-SUFFIX,fliggy.com,DIRECT
  - DOMAIN-SUFFIX,alicdn.com,DIRECT
  - DOMAIN-SUFFIX,aliimg.com,DIRECT
  - DOMAIN-SUFFIX,sspai.com,DIRECT

  # === WeChat / Tencent direct ===
  - DOMAIN-SUFFIX,wechat.com,DIRECT
  - DOMAIN-SUFFIX,wechatlegal.net,DIRECT
  - DOMAIN-SUFFIX,wechatos.net,DIRECT
  - DOMAIN-SUFFIX,wechatpay.com,DIRECT
  - DOMAIN-SUFFIX,weixin.com,DIRECT
  - DOMAIN-SUFFIX,weixinbridge.com,DIRECT
  - DOMAIN-SUFFIX,weixinsxy.com,DIRECT
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,wx.qq.com,DIRECT
  - DOMAIN-SUFFIX,wxs.qq.com,DIRECT
  - DOMAIN-SUFFIX,servicewechat.com,DIRECT
  - DOMAIN-SUFFIX,tenpay.com,DIRECT
  - DOMAIN-SUFFIX,qpic.cn,DIRECT
  - DOMAIN-SUFFIX,qlogo.cn,DIRECT
  - DOMAIN-SUFFIX,gtimg.com,DIRECT
  - DOMAIN-SUFFIX,tc.qq.com,DIRECT

  # === Private ranges ===
  - GEOIP,private,DIRECT,no-resolve

  # === Apple / Apple Music direct ===
  - DOMAIN-SUFFIX,apple.com,DIRECT
  - DOMAIN-SUFFIX,apple.com.cn,DIRECT
  - DOMAIN-SUFFIX,apple-relay.akamaized.net,DIRECT
  - DOMAIN-SUFFIX,apple-relay.cloudflare.com,DIRECT
  - DOMAIN-SUFFIX,apple-relay.fastly-edge.com,DIRECT
  - DOMAIN-SUFFIX,apple-dns.net,DIRECT
  - DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT
  - DOMAIN-SUFFIX,apple-mapkit.com,DIRECT
  - DOMAIN-SUFFIX,apple.news,DIRECT
  - DOMAIN-SUFFIX,cdn-apple.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com.cn,DIRECT
  - DOMAIN-SUFFIX,icloud-content.com,DIRECT
  - DOMAIN-SUFFIX,itunes.com,DIRECT
  - DOMAIN-SUFFIX,itunes.apple.com,DIRECT
  - DOMAIN-SUFFIX,music.apple.com,DIRECT
  - DOMAIN-SUFFIX,mzstatic.com,DIRECT
  - DOMAIN-SUFFIX,aaplimg.com,DIRECT
  - DOMAIN-SUFFIX,me.com,DIRECT
  - DOMAIN-SUFFIX,appsto.re,DIRECT

  # === Force AI/US ===
  - DOMAIN-SUFFIX,formulae.brew.sh,AI
  - DOMAIN-SUFFIX,diabrowser.com,AI

  # === Domestic fallback ===
  - DOMAIN-SUFFIX,cn,DIRECT
  - GEOIP,CN,DIRECT

  # === Default ===
  - MATCH,Final
